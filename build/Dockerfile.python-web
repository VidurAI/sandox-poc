# Platform-owned. Citizen-dev repos never contain a Dockerfile.
FROM <your-acr>.azurecr.io/platform/python-web:3.12-slim
ARG PIP_INDEX_URL
ENV PIP_INDEX_URL=${PIP_INDEX_URL} PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --require-hashes --no-deps -r requirements.txt 2>/dev/null || pip install -r requirements.txt
COPY app/ ./app/
USER 10001
EXPOSE 8080
